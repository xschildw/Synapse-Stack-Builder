    ,
	"${stack}${instance}RepoToMainDbActiveConnectionCountAlarm": {
		"Type" : "AWS::CloudWatch::Alarm",
		"Properties" : {
			"ActionsEnabled" : true,
			"AlarmActions" : [
				{"Fn::ImportValue": "${globalResourcesExportPrefix}-NotificationTopic"}
			],
			"AlarmDescription" : "Alert when the number of active connections from repo instances to the main database gets too high.",
			"AlarmName" : "${stack}-${instance}-Repo-Main-Active-Connections",
			"ComparisonOperator" : "GreaterThanOrEqualToThreshold",
			"Dimensions" : [
				{
					"Name" : "filterClass",
					"Value" : "main"
				}
			],
			"EvaluationPeriods" : 3,
			"Period" : 120,
			"MetricName" : "DataSourceId",
			"Namespace" : "Repo-Database-${instance}",
			"Statistic" : "Maximum",
			"Threshold" : 40,
			"TreatMissingData": "notBreaching"
		}
	}
    ,
